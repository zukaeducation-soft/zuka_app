:"whoosh","pan":0,"d":0.9},{"t":68.95,"type":"drop","pan":-0.6,"n":0},{"t":69.15,"type":"narr","d":10.4,"text":"Pero hay conjuntos que nunca se acaban. En un segmento, entre dos puntos siempre cabe otro, y entre esos, otro más, sin fin."},{"t":69.35,"type":"drop","pan":0.6,"n":4},{"t":69.75,"type":"grid","pan":0,"d":0.8},{"t":70.95,"type":"rise","pan":0},{"t":71.35,"type":"drop","pan":0,"n":1},{"t":72.25,"type":"drop","pan":0,"n":2},{"t":73.05,"type":"drop","pan":0,"n":3},{"t":73.75,"type":"drop","pan":0,"n":4},{"t":74.35,"type":"drop","pan":0,"n":5},{"t":74.95,"type":"drop","pan":0,"n":6},{"t":75.15,"type":"whoosh","pan":0,"d":1.4},{"t":76.15,"type":"drop","pan":0,"n":7},{"t":77.35,"type":"drop","pan":0,"n":8},{"t":77.75,"type":"rise","pan":0},{"t":77.75,"type":"chord","pan":0},{"t":78.55,"type":"drop","pan":0,"n":9},{"t":79.75,"type":"narr","d":5.65,"text":"Tantos puntos, tan juntos, que forman la línea entera. Ese conjunto es infinito."},{"t":79.95,"type":"sweep","pan":0,"d":1.6},{"t":81.55,"type":"whoosh","pan":0,"d":1.2},{"t":83.75,"type":"whoosh","pan":0,"d":1.2},{"t":83.75,"type":"thud","pan":0,"f":55},{"t":85.2,"type":"whoosh","pan":0,"d":1.2},{"t":85.6,"type":"narr","d":5.2,"text":"Cuando hablamos de un tema, todos los objetos de ese tema forman el conjunto universal, que se llama U."},{"t":86.3,"type":"thud","pan":0,"f":60},{"t":86.4,"type":"rise","pan":0},{"t":87.2,"type":"sweep","pan":0,"d":1},{"t":89.1,"type":"drop","pan":0,"n":0},{"t":89.5,"type":"drop","pan":0,"n":1},{"t":89.9,"type":"drop","pan":0,"n":2},{"t":90.3,"type":"drop","pan":0,"n":3},{"t":90.7,"type":"drop","pan":0,"n":4},{"t":90.8,"type":"rise","pan":0},{"t":91,"type":"tick","pan":-0.5,"n":0},{"t":91,"type":"narr","d":13.15,"text":"Si el tema son las letras, las vocales quedan en su círculo y las consonantes afuera de él, pero dentro de U. El universal depende de lo que estemos estudiando."},{"t":91.1,"type":"tick","pan":-0.25,"n":1},{"t":91.2,"type":"tick","pan":0,"n":2},{"t":91.3,"type":"tick","pan":0.25,"n":3},{"t":91.4,"type":"tick","pan":0.5,"n":4},{"t":91.5,"type":"tick","pan":-0.5,"n":5},{"t":91.6,"type":"tick","pan":-0.25,"n":6},{"t":91.7,"type":"tick","pan":0,"n":7},{"t":91.8,"type":"tick","pan":0.25,"n":8},{"t":91.9,"type":"tick","pan":0.5,"n":9},{"t":92,"type":"tick","pan":-0.5,"n":10},{"t":92.1,"type":"tick","pan":-0.25,"n":11},{"t":92.2,"type":"tick","pan":0,"n":12},{"t":92.3,"type":"tick","pan":0.25,"n":13},{"t":92.4,"type":"tick","pan":0.5,"n":14},{"t":92.5,"type":"tick","pan":-0.5,"n":15},{"t":92.6,"type":"tick","pan":-0.25,"n":16},{"t":92.7,"type":"tick","pan":0,"n":17},{"t":92.8,"type":"tick","pan":0.25,"n":18},{"t":92.9,"type":"tick","pan":0.5,"n":19},{"t":93,"type":"tick","pan":-0.5,"n":20},{"t":93.1,"type":"tick","pan":-0.25,"n":21},{"t":93.6,"type":"rise","pan":0},{"t":94.2,"type":"rise","pan":0},{"t":94.2,"type":"chord","pan":0,"big":true},{"t":95.6,"type":"rise","pan":0},{"t":103.3,"type":"whoosh","pan":0,"d":0.5},{"t":104.35,"type":"narr","d":5.6,"text":"Ahora comparemos dos conjuntos. Cada vocal es también una letra: todas las vocales están dentro de las letras."},{"t":104.45,"type":"rise","pan":0},{"t":106.25,"type":"whoosh","pan":0,"d":1.4},{"t":107.7,"type":"thud","pan":0,"f":75},{"t":107.7,"type":"chord","pan":0},{"t":108.75,"type":"rise","pan":0},{"t":110.15,"type":"narr","d":10.25,"text":"V es subconjunto de L cuando todo elemento de V es también elemento de L. El círculo de V queda completamente adentro."},{"t":110.35,"type":"rise","pan":0},{"t":111.95,"type":"rise","pan":0},{"t":119.2,"type":"whoosh","pan":0,"d":0.8},{"t":120.4,"type":"sweep","pan":0,"d":1},{"t":120.6,"type":"narr","d":10.6,"text":"Basta un solo elemento afuera para que no sea subconjunto. El conjunto ese, a no es subconjunto de las letras de sol, porque la a no está."},{"t":120.8,"type":"rise","pan":0},{"t":121.9,"type":"drop","pan":-0.3,"n":0},{"t":122.2,"type":"drop","pan":-0.3,"n":1},{"t":122.5,"type":"drop","pan":-0.3,"n":2},{"t":123,"type":"swee