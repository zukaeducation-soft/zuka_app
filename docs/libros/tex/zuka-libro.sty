% ---------- aperturas de mundo (capítulos) ----------
% \mundo{Título}{id del mundo en la app}{texto de entrada}{lista de lecciones: \item ...}
\newcommand{\mundo}[4]{%
  \cleardoublepage
  \stepcounter{mundo}\setcounter{section}{0}%
  \renewcommand{\zuka@mundoactual}{Mundo \themundo\ · #1}%
  \thispagestyle{vacia}%
  \phantomsection\addcontentsline{toc}{chapter}{\protect\numberline{\themundo}#1}%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[zsoft] (current page.north west) rectangle ([yshift=-96mm]current page.north east);
    % ventana con un trozo del arte de la portada, distinto en cada mundo
    \begin{scope}
      \clip ([xshift=-78mm,yshift=-14mm]current page.north east) [rounded corners=4mm] rectangle ++(64mm,-42mm);
      \pgfmathsetmacro{\zdx}{-70-mod(\themundo*37,110)}\pgfmathsetmacro{\zdy}{170+mod(\themundo*53,120)}
      \node[anchor=north west,inner sep=0] at ([xshift=-78mm+\zdx mm,yshift=-14mm+\zdy mm]current page.north east)
        {\includegraphics[width=300mm]{arte/portada\zuka@num.jpg}};
    \end{scope}
    \draw[zolive,line width=.6pt,rounded corners=4mm] ([xshift=-78mm,yshift=-14mm]current page.north east) rectangle ++(64mm,-42mm);
    \node[anchor=north west,font=\sffamily\small\bfseries,text=zolive]
      at ([xshift=19mm,yshift=-17mm]current page.north west) {M\,U\,N\,D\,O};
    \node[anchor=north west,font=\sffamily\firalight\fontsize{58}{58}\selectfont,text=zmoss]
      at ([xshift=17mm,yshift=-23mm]current page.north west) {\themundo};
    \node[anchor=south west,text width=132mm,align=flush left,font=\sffamily\fontsize{27}{31}\selectfont\fontseries{sb}\selectfont,text=zink]
      at ([xshift=18mm,yshift=-87mm]current page.north west) {#1};
    \draw[zlime,line width=2.2pt] ([xshift=19mm,yshift=-91mm]current page.north west) -- ++(22mm,0);
  \end{tikzpicture}%
  \par\vspace*{82mm}%
  {\large #3\par}\vspace{6mm}%
  \begin{tcolorbox}[enhanced,colback=white,colframe=zline,boxrule=.5pt,arc=3pt,left=5mm,right=5mm,top=3mm,bottom=3mm]
    \kicker{En este mundo}\par\vspace{2pt}
    \begin{itemize}[leftmargin=1.2em,itemsep=3pt]#4\end{itemize}
  \end{tcolorbox}
  \vspace{3mm}
  {\sffamily\small\color{zmute}En la app Zuka este mundo está en \textbf{Preuniversitario UdeA}
   \,›\, \textbf{\zuka@comp}. Cada lección del libro tiene allá su video y sus juegos: lee aquí, juega allá y
   vuelve al taller.\par}
  \immediate\write\zuka@sol{\noexpand\solmun{Mundo \themundo\ · \unexpanded{#1}}}%
}

% red de nodos (el camino de la app) que sirve de motivo; #1 cambia la semilla
\newcommand{\zuka@red}[1]{%
  \pgfmathsetseed{#17}%
  \foreach \i in {1,...,22}{%
    \pgfmathsetmacro{\zx}{-rnd*120}\pgfmathsetmacro{\zy}{(rnd-0.5)*80}%
    \expandafter\xdef\csname zrx\i\endcsname{\zx}\expandafter\xdef\csname zry\i\endcsname{\zy}%
    \coordinate (r\i) at (\zx mm,\zy mm);}%
  \foreach \i in {1,...,22}{\foreach \j in {1,...,22}{%
    \ifnum\i<\j
      \pgfmathsetmacro{\zd}{veclen(\csname zrx\i\endcsname-\csname zrx\j\endcsname,\csname zry\i\endcsname-\csname zry\j\endcsname)}%
      \ifdim\zd pt<34pt \draw[white,opacity=.22,line width=.35pt] (r\i) -- (r\j);\fi
    \fi}}%
  \foreach \i in {1,...,22}{\fill[white,opacity=.55] (r\i) circle (.55mm);}%
  \draw[zlime,line width=.9pt] (r3) -- (r7) -- (r12) -- (r18);
  \foreach \i in {3,7,12}{\fill[zlime] (r\i) circle (.8mm);}
  \draw[zlime,line width=.8pt] (r18) circle (1.6mm);
  \fill[zlime] (r18) circle (.7mm);
}

