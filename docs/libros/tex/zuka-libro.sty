% ---------- taller y ejercicios ----------
\newcounter{ej}
% «Así lo preguntan en el examen»: \examende{id}{\forma{cómo lo preguntan}{ejemplo y respuesta} ...}; sale sola antes del taller
\newcommand{\examende}[2]{\expandafter\gdef\csname zexa@#1\endcsname{\zuka@cajaexamen{#2}}}
\newcommand{\zuka@poneexamen}{\ifcsname zexa@\zuka@lid\endcsname\csname zexa@\zuka@lid\endcsname
  \expandafter\global\expandafter\let\csname zexa@\zuka@lid\endcsname\relax\fi}
\newcounter{forma}
\newcommand{\forma}[2]{\stepcounter{forma}\par\vspace{4pt}\noindent
  \begin{tabularx}{\linewidth}{@{}>{\centering\arraybackslash}p{7mm}X@{}}
  \tikz[baseline=-.6ex]\node[circle,fill=zsky,inner sep=1.3pt,font=\sffamily\scriptsize\bfseries,text=white,minimum size=4.6mm]{\arabic{forma}}; &
  {\sffamily\small\bfseries\color{zink}#1}\par{\small #2}\end{tabularx}}
\newcommand{\zuka@cajaexamen}[1]{\setcounter{forma}{0}%
  \begin{tcolorbox}[zbase,colback=zsky!5,colframe=zsky!40,boxrule=.5pt,left=4mm,right=4mm,top=3mm,bottom=3mm]
  {\sffamily\scriptsize\bfseries\color{zsky}ASÍ LO PREGUNTAN EN EL EXAMEN\quad}{\sffamily\scriptsize\color{zmute}las formas en que aparece este tema}\par
  #1\end{tcolorbox}}
\newcommand{\taller}{\zuka@poneexamen\par\vspace{8pt}\noindent
  \begin{tikzpicture}\node[fill=zlime,rounded corners=2pt,inner xsep=6pt,inner ysep=3pt,
    font=\sffamily\small\bfseries,text=zink]{TALLER \thesection};\end{tikzpicture}\par\vspace{2pt}}
\newcommand{\piso}[2]{\par\vspace{6pt}{\sffamily\small\bfseries\color{zolive}#1}\,{\sffamily\footnotesize\color{zmute}· #2}\par\vspace{1pt}}
\newenvironment{ejercicios}[1][1]{%
  \def\zuka@cols{#1}%
  \ifnum\zuka@cols>1 \begin{multicols}{\zuka@cols}\fi
  \begin{enumerate}[label={\sffamily\bfseries\color{zolive}\arabic*},start=\numexpr\value{ej}+1\relax,
    leftmargin=1.6em,itemsep=5pt,align=left]}
  {\global\setcounter{ej}{\value{enumi}}\end{enumerate}\ifnum\zuka@cols>1 \end{multicols}\fi}
\newenvironment{ejercicios2}{\begin{multicols}{2}\begin{ejercicios}}{\end{ejercicios}\end{multicols}}

% opciones A–D: \opciones (en fila), \opcionesd (2 × 2), \opcionesl (una por renglón)
\newcommand{\op}[1]{{\sffamily\footnotesize\bfseries\color{zolive}#1}\ }
\newcommand{\opciones}[4]{\par\vspace{1pt}\noindent
  \begin{tabularx}{\linewidth}{@{}XXXX@{}}\op{A}#1&\op{B}#2&\op{C}#3&\op{D}#4\end{tabularx}\par}
\newcommand{\opcionesd}[4]{\par\vspace{1pt}\noindent
  \begin{tabularx}{\linewidth}{@{}XX@{}}\op{A}#1&\op{B}#2\\[2pt]\op{C}#3&\op{D}#4\end{tabularx}\par}
\newcommand{\opcionesl}[4]{\par\vspace{1pt}%
  \begin{list}{}{\leftmargin=1.4em\itemsep=1pt\topsep=1pt\labelwidth=1em\labelsep=.4em}
  \item[\op{A}]#1\item[\op{B}]#2\item[\op{C}]#3\item[\op{D}]#4\end{list}}

% ---------- claves (se escriben en un archivo y se imprimen al final) ----------
\newwrite\zuka@sol
\AtBeginDocument{\immediate\openout\zuka@sol=\jobname.sol}
\newcommand{\sol}[1]{\immediate\write\zuka@sol{\noexpand\solitem{\the\value{enumi}}{\unexpanded{#1}}}}
\newcommand{\solhead}[1]{\immediate\write\zuka@sol{\noexpand\solcab{\unexpanded{#1}}}}
\newcommand{\solmundo}[1]{\immediate\write\zuka@sol{\noexpand\solmun{\unexpanded{#1}}}}
\newcommand{\solitem}[2]{\par\noindent\hangindent=1.4em\hangafter=1{\sffamily\footnotesize\bfseries\color{zolive}#1}\ \,{\small#2}\par}
\newcommand{\solcab}[1]{\par\vspace{5pt}{\sffamily\small\bfseries\color{zink}#1}\par\vspace{1pt}}
\newcommand{\solmun}[1]{\par\vspace{10pt}{\sffamily\normalsize\bfseries\color{zolive}#1}\par\vspace{1pt}{\color{zlime}\rule{\linewidth}{.8pt}}\par}
\newcommand{\claves}{%
  \immediate\closeout\zuka@sol
  \cleardoublepage\renewcommand{\zuka@mundoactual}{Claves y soluciones}%
  \phantomsection\addcontentsline{toc}{chapter}{Claves y soluciones}%
  {\sffamily\fontsize{26}{30}\selectfont\firalight Claves y soluciones\par}\vspace{2pt}
  {\color{zlime}\rule{18mm}{1.6pt}}\par\vspace{4pt}
  {\small\color{zmute}La respuesta de cada ejercicio con la idea que la sostiene. Mírala solo después de intentarlo: el
   error que cometas es la mejor pista de qué repasar en la app.\par}
  \vspace{4pt}\begin{multicols}{2}\raggedright\setlength{\parskip}{1.5pt}\InputIfFileExists{\jobname.sol}{}{}\end{multicols}}

