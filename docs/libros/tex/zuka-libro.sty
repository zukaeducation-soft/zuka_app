% ---------- portada y contraportada ----------
\newcommand{\zuka@cerebro}{% marca: cerebro en malla, a línea fina
  \begin{scope}[line width=.5pt,draw=zice]
    \coordinate (a) at (0,0);\coordinate (b) at (.55,.35);\coordinate (c) at (1.1,.42);\coordinate (d) at (1.6,.22);
    \coordinate (e) at (1.85,-.25);\coordinate (f) at (1.55,-.7);\coordinate (g) at (1.0,-.82);\coordinate (h) at (.45,-.7);
    \coordinate (i) at (.05,-.42);\coordinate (m1) at (.6,-.2);\coordinate (m2) at (1.15,-.15);\coordinate (m3) at (.95,-.5);
    \draw (a)--(b)--(c)--(d)--(e)--(f)--(g)--(h)--(i)--cycle;
    \draw (a)--(m1)--(b) (m1)--(c)--(m2)--(d) (m2)--(e) (m2)--(f) (m2)--(m3)--(g) (m3)--(h)--(m1)--(i) (m1)--(m3) (m1)--(m2);
    \draw (m3)--(f);
    \foreach \p in {a,b,c,d,e,f,g,h,i,m1,m2,m3}{\fill[zice] (\p) circle (.035);}
    \fill[zlime] (m2) circle (.06);
  \end{scope}}

% motivos de portada: 1 número y forma, 2 árbol lógico, 3 renglones, 4 dos textos
\newcommand{\zuka@motivo}[1]{%
  \ifcase#1\or
    % 1: retícula de puntos con un triángulo rectángulo y una circunferencia encendidos
    \foreach \x in {0,...,13}{\foreach \y in {0,...,11}{\fill[white,opacity=.22] (\x*9mm,\y*9mm) circle (.45mm);}}
    \foreach \x in {0,...,13}{\draw[white,opacity=.07,line width=.3pt] (\x*9mm,0)--(\x*9mm,99mm);}
    \foreach \y in {0,...,11}{\draw[white,opacity=.07,line width=.3pt] (0,\y*9mm)--(117mm,\y*9mm);}
    \draw[zice,line width=.8pt] (18mm,18mm)--(72mm,18mm)--(72mm,90mm)--cycle;
    \draw[zice,line width=.5pt] (72mm,18mm) rectangle ++(-4mm,4mm);
    \draw[zlime,line width=1pt] (72mm,54mm) circle (36mm);
    \foreach \p in {(18mm,18mm),(72mm,18mm),(72mm,90mm)}{\fill[zlime] \p circle (1.1mm);}
    \node[font=\sffamily\scriptsize,text=zice] at (45mm,13mm) {$a$};
    \node[font=\sffamily\scriptsize,text=zice] at (77mm,54mm) {$b$};
