% ---------- aperturas de mundo (capítulos) ----------
% \mundo{Título}{id del mundo en la app}{texto de entrada}{lista de lecciones: \item ...}
\newcommand{\mundo}[4]{%
  \cleardoublepage
  \stepcounter{mundo}\setcounter{section}{0}%
  \renewcommand{\zuka@mundoactual}{Mundo \themundo\ · #1}%
  \thispagestyle{vacia}%
  \phantomsection\addcontentsline{toc}{chapter}{\protect\numberline{\themundo}#1}%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[znight] (current page.north west) rectangle ([yshift=-92mm]current page.north east);
    \begin{scope}[shift={([xshift=-8mm,yshift=-46mm]current page.north east)}]
      \zuka@red{\themundo}
    \end{scope}
    \node[anchor=north west,font=\sffamily\small\bfseries,text=zlime] at ([xshift=19mm,yshift=-20mm]current page.north west)
      {MUNDO \two@digits{\themundo}};
    \node[anchor=north west,font=\sffamily\footnotesize,text=white!60] at ([xshift=19mm,yshift=-26mm]current page.north west)
      {Zuka Preuniversitario UdeA · #2};
    \node[anchor=south west,text width=110mm,align=left,font=\sffamily\fontsize{30}{32}\selectfont\firalight,text=white]
      at ([xshift=18mm,yshift=-84mm]current page.north west) {#1};
    \draw[zlime,line width=1.6pt] ([xshift=19mm,yshift=-88mm]current page.north west) -- ++(18mm,0);
  \end{tikzpicture}%
  \par\vspace*{76mm}%
  {\large #3\par}\vspace{6mm}%
  \begin{tcolorbox}[enhanced,colback=zsoft,colframe=zsoft,boxrule=0pt,arc=3pt,left=5mm,right=5mm,top=3mm,bottom=3mm]
    \kicker{En este mundo}\par\vspace{2pt}
    \begin{itemize}[leftmargin=1.2em,itemsep=3pt]#4\end{itemize}
  \end{tcolorbox}
  \vspace{3mm}
  {\sffamily\small\color{zmute}En la app Zuka este mundo está en \textbf{Preuniversitario UdeA}
   \,›\, \textbf{\zuka@comp}. Cada lección del libro tiene allá su video y sus diez juegos: lee aquí, juega allá y
   vuelve al taller.\par}
  \immediate\write\zuka@sol{\noexpand\solmun{Mundo \themundo\ · \unexpanded{#1}}}%
}

% red de nodos (el camino de la app) que sirve de motivo; #1 cambia la semilla
\newcommand{\zuka@red}[1]{%
  \pgfmathsetseed{#17}%
  \foreach \i in {1,...,22}{%
    \pgfmathsetmacro{\zx}{-rnd*120}\pgfmathsetmacro{\zy}{(rnd-0.5)*80}%
    \expandafter\xdef\csname zrx\i\endcsname{\zx}\expandafter\xdef\csname zry\i\endcsname{\zy}%
    \coordinate (r\i) at (\zx mm,\zy mm);}%
  \foreach \i in {1,...,22}{\foreach \j in {1,...,22}{%
    \ifnum\i<\j
      \pgfmathsetmacro{\zd}{veclen(\csname zrx\i\endcsname-\csname zrx\j\endcsname,\csname zry\i\endcsname-\csname zry\j\endcsname)}%
      \ifdim\zd pt<34pt \draw[white,opacity=.22,line width=.35pt] (r\i) -- (r\j);\fi
    \fi}}%
  \foreach \i in {1,...,22}{\fill[white,opacity=.55] (r\i) circle (.55mm);}%
  \draw[zlime,line width=.9pt] (r3) -- (r7) -- (r12) -- (r18);
  \foreach \i in {3,7,12}{\fill[zlime] (r\i) circle (.8mm);}
  \draw[zlime,line width=.8pt] (r18) circle (1.6mm);
  \fill[zlime] (r18) circle (.7mm);
}

